# Nama variabel frontend; isi pada lingkungan lokal masing-masing.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Configure as a Supabase Edge Function secret; never expose with a VITE_ prefix.
RAJAONGKIR_API_KEY=

# Secret Edge Function: simpan dengan `supabase secrets set`, jangan isi di file frontend.
MIDTRANS_SERVER_KEY=
